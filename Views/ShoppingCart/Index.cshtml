@model ShoppingCartViewModel

<div class="container my-5">
    <div class="row pt-5">
        <div class="col-12 border-bottom pb-3 mb-4">
            <h2 class="display-5 fw-bold" style="color: var(--primary);">Tu Carrito de Compras</h2>
            <p class="text-muted">Revisa tus platos seleccionados antes de finalizar tu pedido.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            @if (Model.ShoppingCart.ShoppingCartItems.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.ShoppingCart.ShoppingCartItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@line.Dish.ImageThumbnailUrl" alt="@line.Dish.Name" class="rounded me-3" style="width: 80px; height: 60px; object-fit: cover;">
                                            <div>
                                                <h6 class="mb-0 fw-bold">@line.Dish.Name</h6>
                                                <small class="text-muted">@line.Dish.Category?.CategoryName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border p-2">@line.Amount</span>
                                    </td>
                                    <td class="text-end">@line.Dish.Price.ToString("c")</td>
                                    <td class="text-end fw-bold">@((line.Amount * line.Dish.Price).ToString("c"))</td>
                                    <td class="text-end">
                                        <a asp-controller="ShoppingCart" asp-action="RemoveFromShoppingCart" asp-route-dishId="@line.Dish.DishId" class="btn btn-outline-danger btn-sm rounded-circle">
                                            <i class="bi bi-trash"></i> &times;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 shadow-sm rounded-4 bg-light">
                    <div class="mb-3">
                        <i class="bi bi-cart-x display-1 text-muted"></i>
                    </div>
                    <h4 class="text-muted">Tu carrito está vacío</h4>
                    <a asp-controller="Dish" asp-action="List" class="btn btn-primary mt-3 px-4 py-2 rounded-pill">Ver Menú</a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">Resumen del Pedido</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@Model.ShoppingCartTotal.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Envío</span>
                        <span class="text-success fw-bold">Gratis</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 fw-bold">Total</span>
                        <span class="h5 fw-bold text-primary">@Model.ShoppingCartTotal.ToString("c")</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-primary btn-lg rounded-pill fw-bold">Pagar Ahora</a>
                        <a asp-controller="Dish" asp-action="List" class="btn btn-outline-secondary rounded-pill">Seguir Comprando</a>
                    </div>
                </div>
            </div>
            
            <div class="mt-4 p-3 bg-light rounded-4 border border-dashed text-center">
                <small class="text-muted">
                    <i class="bi bi-shield-check"></i> Pago seguro garantizado
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background-color: var(--primary);
        border-color: var(--primary);
    }
    .btn-primary:hover {
        background-color: #b01d00;
        border-color: #b01d00;
    }
    .text-primary {
        color: var(--primary) !important;
    }
    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }
    .card {
        transition: transform 0.3s ease;
    }
</style>
