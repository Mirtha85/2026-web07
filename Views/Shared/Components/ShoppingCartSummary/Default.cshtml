@model ShoppingCartViewModel

<a asp-controller="ShoppingCart" asp-action="Index" class="cart-icon text-decoration-none">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    @if (Model.ShoppingCart.GetShoppingCartItems().Count > 0)
    {
        <span class="cart-badge">@Model.ShoppingCart.GetShoppingCartItems().Count</span>
    }
    else
    {
        <span class="cart-badge">0</span>
    }
</a>
